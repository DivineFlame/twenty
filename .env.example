TAG=latest

# Use the URL users will open in their browser.
# Direct IP access example: SERVER_URL=http://203.0.113.10:3000
# Reverse proxy with HTTPS example: SERVER_URL=https://crm.example.com
SERVER_URL=http://your-server-ip:3000

PG_DATABASE_NAME=default
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=replace_with_a_strong_password_without_special_characters

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace_with_a_random_base64_secret

# Set this only while rotating ENCRYPTION_KEY.
FALLBACK_ENCRYPTION_KEY=

# Legacy secret for older instances. New installs can leave it blank.
APP_SECRET=

STORAGE_TYPE=local

# Optional S3-compatible storage settings.
STORAGE_S3_REGION=
STORAGE_S3_NAME=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

DISABLE_DB_MIGRATIONS=false
DISABLE_CRON_JOBS_REGISTRATION=false
